# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 번역 모델 (기본: claude-opus-5-5)
#  - 더 빠르고 저렴하게: claude-sonnet-5-5 또는 claude-haiku-5-5
TRANSLATOR_MODEL=claude-opus-5-5

# 추론 강도: low(가장 빠름, 실시간 번역에 권장) | medium | high
TRANSLATOR_EFFORT=low

# 서버 포트
PORT=3000
HTTPS_PORT=3443

# (선택) 인터넷에 공개할 때 접속 비밀번호. 비워두면 비밀번호 없음.
APP_PASSWORD=
